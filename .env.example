# Copy to .env and adjust. Never commit .env.
# Every value below is a local-development default, not a real credential.

# --- Model provider -----------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run the whole system with the deterministic
# fake model (recorded responses). Set it to use Claude for real.
ANTHROPIC_API_KEY=
# Model identifiers live in configuration, never in code. See docs/decisions.
TRAMITA_MODEL_FAST=claude-haiku-5-5
TRAMITA_MODEL_SMART=claude-sonnet-5-5

# --- PostgreSQL (core system + pgvector) --------------------------------------
POSTGRES_USER=tramita
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tramita
POSTGRES_PORT=5432

# --- Kafka (KRaft, single broker) ---------------------------------------------
KAFKA_PORT=9092

# --- OpenSearch ----------------------------------------------------------------
OPENSEARCH_PORT=9200

# --- S3-compatible document store (RustFS locally) ----------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tramita
S3_SECRET_KEY=change-me-local-only
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=claim-documents

# --- Temporal -------------------------------------------------------------------
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Core API keys ----------------------------------------------------------------
# name:ROLE:key;... Roles: AGENT (propose), REVIEWER (approve/correct/reject), ANALYST (read),
# ADMIN (import reference data). Keys need at least 16 characters.
TRAMITA_API_KEYS=agents:AGENT:agents-change-me-local-only;console:REVIEWER:console-change-me-local-only;analyst:ANALYST:analyst-change-me-local-only;admin:ADMIN:admin-change-me-local-only

# --- Services ---------------------------------------------------------------------
CORE_PORT=8080
AGENTS_PORT=8000
