{
  "uid": "tramita-overview",
  "title": "Tramita overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "tramita"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Claims analysed by the agents, by routing (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tramita_routing) (rate(tramita_claims_analysed_total[5m])) * 60",
          "legendFormat": "{{tramita_routing}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rules outcomes in the core (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision, routing) (rate(tramita_proposals_total[5m])) * 60",
          "legendFormat": "{{decision}} / {{routing}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model call duration p95 by task",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tramita_task) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tramita_task}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens per minute by task and type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tramita_task, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m])) * 60",
          "legendFormat": "{{tramita_task}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline stage duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tramita_stage) (rate(tramita_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tramita_stage}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Core API latency p95 by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"core\"}[5m])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    }
  ]
}
